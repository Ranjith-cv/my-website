# GOOGLE GEMINI API CONFIGURATION

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# GENERATION SETTINGS
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# GOOGLE SHEETS ENQUIRY INTEGRATION (Optional)
# Paste your deployed Google Apps Script Web App URL here to automatically log form submissions
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
